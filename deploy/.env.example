# The installer creates ~/.garden-diary/config/.env with a random setup token.
# Never commit real secrets. Manual installations must set GD_SETUP_TOKEN.
GD_CHANNEL=master
GD_REF=
GD_UID=1000
GD_GID=1000
GD_SETUP_TOKEN=
GD_APP_IMAGE=ghcr.io/lazyxu/garden-diary-api:latest
GD_WEB_IMAGE=ghcr.io/lazyxu/garden-diary-web:latest
GD_DATA_DIR=
GD_CADDY_DATA_DIR=
GD_CADDY_CONFIG_DIR=
GD_HTTP_BIND=0.0.0.0
GD_HTTP_PORT=3018

# Optional domain: set GD_DOMAIN and activate the https Compose profile.
# Public DNS and inbound HTTP 80/HTTPS 443 are required for Caddy ACME.
GD_DOMAIN=
GD_HTTPS_HTTP_PORT=80
GD_HTTPS_PORT=443
