FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
RUN go mod tidy && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/garden-diary ./cmd/garden-diary

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libheif-examples \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/garden-diary /usr/local/bin/garden-diary
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/garden-diary"]
